<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sey-tech | Web Developer & Creative Designer</title>

    <style>
        /* =========================
           RESET
        ========================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #080808;
            color: #ffffff;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        /* =========================
           SIDEBAR / NAVIGATION
        ========================== */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 260px;
            height: 100vh;
            background: #101010;
            border-right: 1px solid #222;
            padding: 35px 25px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .logo {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .logo span {
            color: #00e5ff;
        }

        .nav-links {
            margin-top: 50px;
        }

        .nav-links li {
            margin-bottom: 12px;
        }

        .nav-links a {
            display: block;
            padding: 14px 16px;
            border-radius: 10px;
            color: #aaa;
            transition: 0.3s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            background: #00e5ff;
            color: #000;
            transform: translateX(5px);
        }

        .sidebar-bottom {
            color: #777;
            font-size: 13px;
        }

        /* =========================
           MOBILE MENU BUTTON
        ========================== */

        .menu-btn {
            display: none;
            position: fixed;
            right: 20px;
            top: 20px;
            z-index: 2000;
            width: 48px;
            height: 48px;
            border: 1px solid #333;
            border-radius: 10px;
            background: #111;
            color: white;
            font-size: 23px;
            cursor: pointer;
        }

        /* =========================
           MAIN
        ========================== */

        main {
            margin-left: 260px;
        }

        section {
            min-height: 100vh;
            padding: 100px 8%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* =========================
           HERO
        ========================== */

        .hero {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(circle at 80% 20%, rgba(0,229,255,0.15), transparent 30%),
                #080808;
        }

        .hero-content {
            max-width: 950px;
        }

        .small-title {
            color: #00e5ff;
            font-weight: bold;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: clamp(50px, 7vw, 100px);
            line-height: 0.95;
            margin-bottom: 30px;
        }

        .hero h1 span {
            color: #00e5ff;
        }

        .hero p {
            max-width: 700px;
            color: #aaa;
            font-size: 19px;
            margin-bottom: 35px;
        }

        .buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 15px 25px;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
            display: inline-block;
        }

        .primary {
            background: #00e5ff;
            color: #000;
        }

        .secondary {
            border: 1px solid #444;
            color: #fff;
        }

        .btn:hover {
            transform: translateY(-4px);
        }

        /* =========================
           SECTION HEADERS
        ========================== */

        .section-title {
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: clamp(35px, 5vw, 60px);
            margin-bottom: 10px;
        }

        .section-title p {
            color: #888;
            max-width: 600px;
        }

        /* =========================
           SERVICES
        ========================== */

        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .service-card {
            background: #111;
            border: 1px solid #222;
            border-radius: 15px;
            padding: 30px;
            min-height: 260px;
            transition: 0.3s;
        }

        .service-card:hover {
            border-color: #00e5ff;
            transform: translateY(-8px);
        }

        .service-icon {
            font-size: 35px;
            margin-bottom: 25px;
        }

        .service-card h3 {
            margin-bottom: 12px;
            font-size: 22px;
        }

        .service-card p {
            color: #888;
        }

        /* =========================
           ABOUT
        ========================== */

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .about-text p {
            color: #999;
            margin-bottom: 20px;
            font-size: 17px;
        }

        .skills {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .skill {
            background: #111;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #222;
        }

        .skill strong {
            display: block;
            margin-bottom: 5px;
        }

        .skill span {
            color: #777;
            font-size: 14px;
        }

        /* =========================
           PORTFOLIO
        ========================== */

        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .project {
            height: 330px;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            background: #151515;
            border: 1px solid #222;
        }

        .project-content {
            position: absolute;
            inset: 0;
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            background: linear-gradient(
                transparent,
                rgba(0,0,0,0.95)
            );
        }

        .project h3 {
            font-size: 24px;
            margin-bottom: 5px;
        }

        .project p {
            color: #aaa;
        }

        /* =========================
           CONTACT
        ========================== */

        .contact-box {
            background: #101010;
            border: 1px solid #222;
            border-radius: 20px;
            padding: 50px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
        }

        .contact-info h3 {
            font-size: 35px;
            margin-bottom: 20px;
        }

        .contact-info p {
            color: #888;
            margin-bottom: 25px;
        }

        .contact-item {
            margin-bottom: 15px;
            color: #bbb;
        }

        .contact-item strong {
            color: white;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 16px;
            background: #080808;
            border: 1px solid #333;
            color: white;
            border-radius: 8px;
            outline: none;
        }

        .contact-form textarea {
            height: 150px;
            resize: none;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: #00e5ff;
        }

        /* =========================
           FOOTER
        ========================== */

        footer {
            margin-left: 260px;
            padding: 40px 8%;
            border-top: 1px solid #222;
            background: #050505;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .socials {
            display: flex;
            gap: 10px;
        }

        .socials a {
            padding: 10px 15px;
            border: 1px solid #333;
            border-radius: 7px;
            color: #aaa;
            transition: 0.3s;
        }

        .socials a:hover {
            border-color: #00e5ff;
            color: #00e5ff;
        }

        /* =========================
           RESPONSIVENESS
        ========================== */

        @media (max-width: 1100px) {

            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .portfolio-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 800px) {

            .sidebar {
                transform: translateX(-100%);
                transition: 0.3s;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .menu-btn {
                display: block;
            }

            main {
                margin-left: 0;
            }

            footer {
                margin-left: 0;
            }

            section {
                padding: 80px 6%;
            }

            .about-grid,
            .contact-box {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {

            .hero h1 {
                font-size: 55px;
            }

            .hero p {
                font-size: 16px;
            }

            .services-grid,
            .portfolio-grid,
            .skills {
                grid-template-columns: 1fr;
            }

            .contact-box {
                padding: 30px 20px;
            }

            .footer-content {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar" id="sidebar">

        <div>
            <div class="logo">
                SEY<span>TECH</span>
            </div>

            <ul class="nav-links">

                <li>
                    <a href="#home" class="active">Home</a>
                </li>

                <li>
                    <a href="#services">Services</a>
                </li>

                <li>
                    <a href="#about">About</a>
                </li>

                <li>
                    <a href="#portfolio">Portfolio</a>
                </li>

                <li>
                    <a href="#contact">Contact</a>
                </li>

            </ul>
        </div>

        <div class="sidebar-bottom">
            
        </div>

    </aside>


    <!-- MOBILE BUTTON -->

    <button class="menu-btn" id="menuBtn">
        ☰
    </button>


    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <main>

        <!-- HERO -->

        <section class="hero" id="home">

            <div class="hero-content">

                <div class="small-title">
                    Creative Developer
                </div>

                <h1>
                    I Build<br>
                    <span>Digital</span><br>
                    Experiences.
                </h1>

                <p>
                    I'm Sey — a web developer, graphics designer,
                    printing specialist and digital creative helping
                    individuals and businesses turn ideas into
                    professional digital experiences.
                </p>

                <div class="buttons">

                    <a href="#portfolio" class="btn primary">
                        View My Work
                    </a>

                    <a href="#contact" class="btn secondary">
                        Let's Work Together
                    </a>

                </div>

            </div>

        </section>


        <!-- SERVICES -->

        <section id="services">

            <div class="section-title">

                <h2>What I Do.</h2>

                <p>
                    From websites to graphics and physical printing,
                    I provide creative digital solutions.
                </p>

            </div>


            <div class="services-grid">

                <div class="service-card">

                    <div class="service-icon">
                        &lt;/&gt;
                    </div>

                    <h3>Web Development</h3>

                    <p>
                        Responsive and modern websites built
                        using HTML, CSS, JavaScript and other
                        web technologies.
                    </p>

                </div>


                <div class="service-card">

                    <div class="service-icon">
                        🎨
                    </div>

                    <h3>Graphics Design</h3>

                    <p>
                        Professional flyers, logos, banners,
                        social media designs and brand visuals.
                    </p>

                </div>


                <div class="service-card">

                    <div class="service-icon">
                        🖨️
                    </div>

                    <h3>Printing</h3>

                    <p>
                        Quality printing solutions for flyers,
                        business cards, banners, posters and
                        other promotional materials.
                    </p>

                </div>


                <div class="service-card">

                    <div class="service-icon">
                        ⚡
                    </div>

                    <h3>Digital Solutions</h3>

                    <p>
                        Creative digital solutions designed to
                        help businesses build a stronger online
                        presence.
                    </p>

                </div>

            </div>

        </section>


        <!-- ABOUT -->

        <section id="about">

            <div class="section-title">

                <h2>About Me.</h2>

                <p>
                    A creative mind combining technology and design.
                </p>

            </div>


            <div class="about-grid">

                <div class="about-text">

                    <p>
                        I'm a web developer and creative designer
                        passionate about technology, design and
                        building things that people can actually use.
                    </p>

                    <p>
                        My work combines development, graphics,
                        branding and printing to provide clients
                        with a complete creative solution.
                    </p>

                    <p>
                        Whether you need a website, a brand identity,
                        graphics or professional printing, I'm ready
                        to bring the idea to life.
                    </p>

                </div>


                <div class="skills">

                    <div class="skill">
                        <strong>HTML & CSS</strong>
                        <span>Web Development</span>
                    </div>

                    <div class="skill">
                        <strong>JavaScript</strong>
                        <span>Interactive Websites</span>
                    </div>

                    <div class="skill">
                        <strong>Graphics Design</strong>
                        <span>Branding & Visuals</span>
                    </div>

                    <div class="skill">
                        <strong>Printing</strong>
                        <span>Physical Branding</span>
                    </div>

                    <div class="skill">
                        <strong>UI Design</strong>
                        <span>Modern Interfaces</span>
                    </div>

                    <div class="skill">
                        <strong>Branding</strong>
                        <span>Business Identity</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- PORTFOLIO -->

        <section id="portfolio">

            <div class="section-title">

                <h2>My Work.</h2>

                <p>
                    A selection of projects and creative work.
                </p>

            </div>


            <div class="portfolio-grid">

                <div class="project">

                    <div class="project-content">

                        <h3>Business Website</h3>

                        <p>Web Development</p>

                    </div>

                </div>


                <div class="project">

                    <div class="project-content">

                        <h3>Brand Identity</h3>

                        <p>Graphics & Branding</p>

                    </div>

                </div>


                <div class="project">

                    <div class="project-content">

                        <h3>Social Media Design</h3>

                        <p>Graphics Design</p>

                    </div>

                </div>


                <div class="project">

                    <div class="project-content">

                        <h3>Printing Project</h3>

                        <p>Printing & Branding</p>

                    </div>

                </div>


                <div class="project">

                    <div class="project-content">

                        <h3>Portfolio Website</h3>

                        <p>Web Development</p>

                    </div>

                </div>


                <div class="project">

                    <div class="project-content">

                        <h3>Creative Campaign</h3>

                        <p>Digital Design</p>

                    </div>

                </div>

            </div>

        </section>


        <!-- CONTACT -->

        <section id="contact">

            <div class="section-title">

                <h2>Let's Work.</h2>

                <p>
                    Have a project in mind? Let's build something
                    great together.
                </p>

            </div>


            <div class="contact-box">

                <div class="contact-info">

                    <h3>Start a project.</h3>

                    <p>
                        Tell me what you need and let's discuss
                        how I can help bring your idea to life.
                    </p>

                    <div class="contact-item">
                        <strong>WhatsApp:</strong>
                        +234 9046068485
                    </div>

                    <div class="contact-item">
                        <strong>Email:</strong>
                        cupidb@gmail.com
                    </div>

                    <div class="contact-item">
                        <strong>Location:</strong>
                        Nigeria
                    </div>

                </div>


                <form class="contact-form" id="contactForm">

                    <input
                        type="text"
                        placeholder="Your Name"
                        required
                    >

                    <input
                        type="email"
                        placeholder="Your Email"
                        required
                    >

                    <textarea
                        placeholder="Tell me about your project..."
                        required
                    ></textarea>

                    <button
                        type="submit"
                        class="btn primary"
                    >
                        Send Message
                    </button>

                </form>

            </div>

        </section>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <div class="footer-content">

            <div>
                <strong>SEY-TECH</strong>
                <p style="color:#777;">
                    Web • Graphics • Printing • Digital<br> © 2026 Seytech
                </p>
            </div>


            <div class="socials">

                <a href="#" target="_blank">
                    Instagram
                </a>

                <a href="#" target="_blank">
                    Facebook
                </a>

                <a href="#" target="_blank">
                    TikTok
                </a>

                <a href="#" target="_blank">
                    GitHub
                </a>

            </div>

        </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        const menuBtn = document.getElementById("menuBtn");
        const sidebar = document.getElementById("sidebar");

        menuBtn.addEventListener("click", () => {

            sidebar.classList.toggle("open");

            if (sidebar.classList.contains("open")) {
                menuBtn.innerHTML = "✕";
            } else {
                menuBtn.innerHTML = "☰";
            }

        });


        // Close mobile menu when a link is clicked

        const navLinks = document.querySelectorAll(".nav-links a");

        navLinks.forEach(link => {

            link.addEventListener("click", () => {

                sidebar.classList.remove("open");
                menuBtn.innerHTML = "☰";

            });

        });


        // Active navigation link

        window.addEventListener("scroll", () => {

            let current = "";

            document.querySelectorAll("section").forEach(section => {

                const sectionTop = section.offsetTop - 200;

                if (window.scrollY >= sectionTop) {
                    current = section.getAttribute("id");
                }

            });

            navLinks.forEach(link => {

                link.classList.remove("active");

                if (link.getAttribute("href") === "#" + current) {
                    link.classList.add("active");
                }

            });

        });


        // Contact form

        const contactForm =
            document.getElementById("contactForm");

        contactForm.addEventListener("submit", function(event) {

            event.preventDefault();

            alert(
                "Thanks for contacting Seytech! " +
                "I'll get back to you soon."
            );

            contactForm.reset();

        });

    </script>

</body>
</html>
